<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PttDictation.Core\PttDictation.Core.csproj" />
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.0.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\PttDictation.ico" LogicalName="PttDictation.AppIcon.ico" />
    <EmbeddedResource Include="Assets\TrayIdle.ico" LogicalName="PttDictation.TrayIdle.ico" />
    <EmbeddedResource Include="Assets\TrayActive.ico" LogicalName="PttDictation.TrayActive.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\tools\qwen-worker\qwen_worker.py" Link="qwen-worker\qwen_worker.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>PttDictation</AssemblyName>
    <ApplicationIcon>Assets\PttDictation.ico</ApplicationIcon>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
